    orcid: "https://orcid.org/0009-0007-1619-374X"
    affiliation: "Independent Researcher"

repository-code: "https://github.com/NodeX-AR/Pytml"
url: "https://pytml.js.org"
license: "Apache-2.0"

identifiers:
